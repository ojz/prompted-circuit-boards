cabal-version:      2.4
name:               pcbgen
version:            0.1.0.0
synopsis:           Generate KiCad projects for Eurorack modules from a Haskell description
license:            NONE
build-type:         Simple

common shared
    default-language: Haskell2010
    ghc-options:      -O2 -rtsopts -Wall -Wno-name-shadowing
    build-depends:
        base >=4.14 && <5,
        text,
        containers,
        array,
        directory,
        filepath,
        process

library
    import:           shared
    hs-source-dirs:   toolkit/src
                      modules/mult
                      modules/attenuverter
                      modules/_tests/route-test
                      modules/_bench
    exposed-modules:
        Kicad.SExpr
        Kicad.Library
        Kicad.Uuid
        Design
        Block.Eurorack
        Block.Power
        Validate
        Bench
        Emit.Schematic
        Emit.Pcb
        Emit.Project
        Emit.Spice
        Route.Geometry
        Route.Analog
        Route.Coupling
        Route.Check
        Route.Router
        Route.Extract
        Attenuverter
        AttenuverterPanel
        Mult
        MultPanel
        RouteTest
        BenchFixtures

executable pcbgen
    import:           shared
    hs-source-dirs:   toolkit/app
    main-is:          Main.hs
    build-depends:    pcbgen

test-suite pcbgen-test
    import:           shared
    type:             exitcode-stdio-1.0
    hs-source-dirs:   toolkit/test
    main-is:          Main.hs
    other-modules:    Harness
                      AnalogTests
                      BlockTests
                      SpiceTests
                      ValidateTests
                      RouteTests
                      BenchTests
    build-depends:    pcbgen
