(version 1)

# Thonkiconn (WQP-PJ398SM) official footprint carries a courtyard 14.4 mm long
# (-1.42 .. 12.98 mm from the barrel), but the physical body is 10.5 mm and the
# barrel sits on top of the body, so stacked jacks at 13 mm pitch do not collide.
# Allow up to 1.5 mm courtyard overlap between jacks only; everything else keeps
# the default zero-overlap check.
(rule "jack_column_courtyard_overlap"
  (condition "A.Reference == 'J*' && B.Reference == 'J*'")
  (constraint courtyard_clearance (min -1.5mm)))

# The jack body outline (F.SilkS) touches the next jack's pin marker at 13.7 mm
# pitch. Front silkscreen sits under the panel and is never visible, and the
# lines merely touch, so silence silk-to-silk clearance between jacks only.
(rule "jack_column_silk_touch"
  (severity ignore)
  (condition "A.Reference == 'J*' && B.Reference == 'J*'")
  (constraint silk_clearance (min 0mm)))
